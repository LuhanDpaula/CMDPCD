Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia arquivos ocultos (.htaccess, .env, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Documentos antigos de PCD que ainda estejam em uploads/ NUNCA são servidos direto
    RewriteRule ^uploads/pcd_doc_ - [F,L,NC]

    # Se o arquivo ou diretório existir fisicamente, serve ele diretamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Caso contrário, envia para o Front Controller index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
